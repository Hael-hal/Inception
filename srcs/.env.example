# ==========================================
# Inception Environment Configuration Template
# ==========================================

# User Login & Host Domain
LOGIN=your_login
DOMAIN_NAME=your_login.42.fr

# Database Configuration (MariaDB)
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user
MYSQL_PASSWORD_FILE=/run/secrets/db_password
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password
MYSQL_PASSWORD=change_this_user_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# WordPress Website & Administrator Configuration
# NOTE: Administrator username MUST NOT contain 'admin' or 'administrator'
WP_TITLE=Inception 42
WP_ADMIN_USER=chief_operator
WP_ADMIN_PASSWORD_FILE=/run/secrets/wp_admin_password
WP_ADMIN_PASSWORD=change_this_admin_password
WP_ADMIN_EMAIL=chief_operator@student.42.fr

# WordPress Secondary User Configuration
WP_USER=staff_editor
WP_USER_PASSWORD_FILE=/run/secrets/wp_user_password
WP_USER_PASSWORD=change_this_editor_password
WP_USER_EMAIL=staff_editor@student.42.fr
